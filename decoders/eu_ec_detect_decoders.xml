<!--
  Optional decoder for eu-ec-detect-community collector JSON summaries,
  if you choose to ship those files to a Wazuh manager.

  The detection rules in rules/eu_ec_detect_rules.xml do NOT depend on this
  decoder. They use default Wazuh decoders for SSH, PAM, process monitoring,
  and FIM.

  This decoder only classifies a line that looks like the collector's JSON
  object (it starts with {"timestamp":). It does not remap standard Wazuh
  fields. Field extraction can be added after validation with wazuh-logtest.

  These decoders have NOT been tested with wazuh-logtest against a live
  manager. Licensed under the Apache License, Version 2.0.
-->
<decoder name="eu-ec-collect-json">
  <prematch>^{"timestamp":</prematch>
</decoder>
