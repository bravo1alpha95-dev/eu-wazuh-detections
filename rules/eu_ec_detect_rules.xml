<!--
  EmpowerU LLC — eu-wazuh-detections
  Custom rule IDs: 100002, 100010–100013, 100016–100018, 100020–100021 (range 100000+).

  Parent SIDs were verified with wazuh-logtest against wazuh/wazuh-manager:4.14.10
  on 2026-11-13. Confirmed default IDs on that version:

    530  — process monitoring ("ossec: output:")
    550  — FIM integrity checksum changed (plugin decoder)
    5501 — PAM login session opened (SUCCESS)
    5503 — PAM authentication failure (FAILURE)
    5551 — PAM: 8 failed logins in 180s from the same source IP
    5710 — SSH attempt using a non-existent user
    5712 — SSH brute force, non-existent user (8x 5710 in 120s)
    5715 — SSH authentication success
    5760 — SSH authentication failed ("Failed password"); more specific than 5716
    5763 — SSH brute force, authentication failed (8x 5760)

  IMPORTANT: An earlier draft swapped 5501 and 5503 (treating 5501 as failure
  and 5503 as success). That is wrong on 4.14.10 and on long-standing
  Wazuh/OSSEC PAM rules. With the swapped IDs, 100012 alerted on failed PAM
  logins during 00:00-05:00, and 100010 did not count actual failures.

  Frequency rules 100010 and 100016 are children of the default correlation
  SIDs (5551, 5712, 5763). Sibling copies of those defaults never became the
  leaf alert in logtest — the default rule won. The EmpowerU IDs add a
  labeled alert on top. Disable or raise levels if you see duplicate alerts
  you do not want.

  The <time> option uses the manager's local clock, not the log timestamp.
  Tune thresholds, hours, and match lists to your baseline.

  Licensed under the Apache License, Version 2.0.
-->
<group name="local,empoweru,eu-ec-detect,">

  <!-- Derived from unexpected-listener checks in the community collector.
       Process-start parent (default 530) is an approximation: Wazuh flags the
       process-monitoring command output, not a confirmed new listening socket.
       Use the host anomaly-checks.sh baseline as well. -->
  <rule id="100002" level="12">
    <if_sid>530</if_sid>
    <match>nc |ncat |socat |python -m http|busybox</match>
    <description>eu-ec-detect: unexpected process associated with a network listener (possible rogue or backdoor)</description>
    <mitre>
      <id>T1571</id>
    </mitre>
    <group>eu_unexpected_listener,</group>
  </rule>

  <!-- Multiple failed authentications from one source. Child of default 5551
       (8 PAM failures in 180s, same_source_ip) so this ID is the leaf alert.
       Parent 5503 is the PAM failure rule — not 5501, which is success. -->
  <rule id="100010" level="10">
    <if_sid>5551</if_sid>
    <description>eu-ec-detect: multiple failed logins from the same source IP (PAM/syslog)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>eu_auth_fail_burst,</group>
  </rule>

  <!-- SSH companion: child of default 5712 (invalid-user burst) and 5763
       (failed-password burst). 5716 is not the leaf for "Failed password"
       on 4.14.10 — 5760 is — so 5720 (if_matched_sid 5716) does not fire. -->
  <rule id="100016" level="10">
    <if_sid>5712,5763</if_sid>
    <description>eu-ec-detect: multiple failed SSH logins from the same source IP</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>eu_auth_fail_burst,</group>
  </rule>

  <!-- Success after a burst of failures. Correlation against 100010.
       5501 is PAM session opened (success). Timeframe 180s aligns with 5551.
       same_source_ip is omitted: PAM "session opened" logs often have no
       rhost/srcip, so that option would prevent this rule from firing. -->
  <rule id="100011" level="12" timeframe="180">
    <if_sid>5501</if_sid>
    <if_matched_sid>100010</if_matched_sid>
    <description>eu-ec-detect: successful login after multiple failures (possible credential stuffing or brute-force success)</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
    <group>eu_auth_success_after_fail,</group>
  </rule>

  <rule id="100017" level="12" timeframe="180">
    <if_sid>5715</if_sid>
    <if_matched_sid>100016</if_matched_sid>
    <same_source_ip />
    <description>eu-ec-detect: successful SSH login after multiple failures from the same source</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
    <group>eu_auth_success_after_fail,</group>
  </rule>

  <!-- Baseline deviation, not a specific ATT&CK technique. Tune the window.
       Uses manager local time. 5501 is PAM success. -->
  <rule id="100012" level="8">
    <if_sid>5501</if_sid>
    <time>00:00-05:00</time>
    <description>eu-ec-detect: successful login during unusual hours (00:00-05:00, PAM/syslog)</description>
    <group>eu_offhours_login,</group>
  </rule>

  <rule id="100018" level="8">
    <if_sid>5715</if_sid>
    <time>00:00-05:00</time>
    <description>eu-ec-detect: successful SSH login during unusual hours (00:00-05:00)</description>
    <group>eu_offhours_login,</group>
  </rule>

  <!-- Root SSH success. T1078 is accurate for use of the root account. -->
  <rule id="100013" level="10">
    <if_sid>5715</if_sid>
    <user>root</user>
    <description>eu-ec-detect: successful SSH login as root</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>eu_root_ssh,</group>
  </rule>

  <!-- FIM on critical binary paths. No MITRE ID: a path change is not, by
       itself, a clearly single ATT&CK technique. Parent 550 is the default
       syscheck/FIM "integrity checksum changed" rule. wazuh-logtest on
       4.14.10 does not invoke the FIM plugin decoder, so these two rules
       were checked for load only, not for a fired leaf ID. -->
  <rule id="100020" level="12">
    <if_sid>550</if_sid>
    <match>/usr/bin/|/usr/sbin/|/bin/|/sbin/</match>
    <description>eu-ec-detect: critical binary path modified (file integrity)</description>
    <group>eu_fim_critical,</group>
  </rule>

  <!-- FIM on access-policy files the collector also reviews. -->
  <rule id="100021" level="12">
    <if_sid>550</if_sid>
    <match>/etc/ssh/sshd_config|/etc/sudoers|/etc/sudoers.d/</match>
    <description>eu-ec-detect: SSH or sudo policy file modified (file integrity)</description>
    <group>eu_fim_policy,</group>
  </rule>

</group>
